# URL of your Odoo 19 server (server side only, never exposed to the browser)
ODOO_URL=http://127.0.0.1:8069
# Database name (leave empty if the server has a single database)
ODOO_DB=demo

# Set to gym to run the Gym Town application on the same app (default: Otomater lifecycle)
NEXT_PUBLIC_APP_MODE=gym
NEXT_PUBLIC_APP_NAME=Gym Town
